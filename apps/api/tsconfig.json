{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "esnext"
    ],
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "sourceMap": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "eslint.config.ts",
    "prisma.config.ts",
    "generated",
    "tests",
    "node_modules",
    "dist"
  ]
}
