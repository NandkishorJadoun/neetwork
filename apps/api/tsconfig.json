{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  "exclude": ["eslint.config.ts", "prisma.config.ts", "generated", "tests", "node_modules", "dist"]
}
