{
  "name": "neetwork",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "license": "MIT",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "lint": "pnpm run --parallel lint",
    "lint:fix": "pnpm run --parallel lint:fix",
    "type-check": "pnpm run -r --parallel type-check",
    "build": "pnpm --filter api build",
    "start": "pnpm --filter api start",
    "prepare": "husky"
  },
  "devDependencies": {
    "@neetwork/eslint-config": "workspace:*",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,css,md}": [
      "eslint --fix --no-warn-ignored"
    ]
  }
}
