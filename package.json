{
  "name": "neetwork",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "lint": "pnpm run -r --parallel lint",
    "type-check": "pnpm run -r --parallel type-check"
  }
}